{
  "name": "@ordinoxai/legal-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "OrdinoxAI Mother Brain — legal orchestrator skeleton (Task 4)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:3012": "cross-env PORT=3012 node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "validate:migrations": "vitest run src/tests/migrationSprint6Schema.test.ts src/tests/migrationSprint9Schema.test.ts src/tests/migrationSprint10SourceRegistry.test.ts src/tests/postgresRetrievalTemporalSql.test.ts src/tests/migrationSprint11RagSupersededBy.test.ts src/tests/migrationSprint11QaCacheSchema.test.ts src/tests/migrationSprint11RateCalculationHistory.test.ts",
    "ingest:dry-run": "tsx scripts/ingest-cli.ts --limit 50",
    "ingest:source": "tsx scripts/ingest-cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vitest": "^3.1.3"
  }
}
