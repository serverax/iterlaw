{
  "name": "iterlaw",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web", "api", "apps/legal-orchestrator", "packages/*"],
  "description": "UK employment law assistant — Gov APIs first, AI fallback, cached answers",
  "scripts": {
    "dev": "npm run dev -w @iterlaw/web",
    "build": "npm run build:web",
    "build:web": "npm run build -w @iterlaw/shared && npm run build -w @iterlaw/web",
    "build:orchestrator": "npm run build --prefix apps/legal-orchestrator",
    "build:backend": "npm run build --prefix backend",
    "build:packages": "npm run build -w @iterlaw/shared && npm run build -w @iterlaw/legal-core",
    "build:api": "npm run build -w @iterlaw/api",
    "start": "npm run start -w @iterlaw/web",
    "start:docker": "docker compose -f docker-compose.local.yml up -d",
    "stop:docker": "docker compose -f docker-compose.local.yml down",
    "lint": "npm run lint -w @iterlaw/web",
    "lint:fix": "npm run lint -w @iterlaw/web -- --fix",
    "typecheck": "npm run typecheck -w @iterlaw/web",
    "type-check": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"backend/**/*.{ts,js,json}\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:pipeline": "ts-node -r dotenv/config test-harness.ts",
    "test:sprint-1": "ts-node apps/legal-orchestrator/scripts/sprint-1-run.ts",
    "security:scan": "npm audit --omit=dev --audit-level=high",
    "audit:fix-check": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run test:ci && npm run build:web",
    "health": "node -e \"Promise.all([fetch('http://localhost:3000/health'),fetch('http://localhost:8081/health')]).then(async r=>{for (const x of r) console.log(x.status, await x.text())}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^15.5.18",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss@<8.5.10": "8.5.14"
  },
  "engines": {
    "node": ">=20"
  }
}
