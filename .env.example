# Supabase (auth + Postgres cache for answers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the client (alias supported: SUPABASE_SERVICE_KEY)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Optional AI timeout override (orchestrators / future agents)
AI_REQUEST_TIMEOUT_MS=5000

# AI fallback (use at least one; router may prefer Gemini for cost)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Step 6 — AI fallback (Google Gemini + Anthropic Claude)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_MODEL=claude-sonnet-4-20250514
AI_TIMEOUT_SIMPLE_MS=6000
AI_TIMEOUT_COMPLEX_MS=10000

# Gov layer (defaults are fine for GOV.UK; override if proxying)
GOV_UK_CONTENT_API_BASE=https://www.gov.uk/api/content

# Gov API orchestration (Step 4)
COMPANIES_HOUSE_API_KEY=
GOV_API_TIMEOUT_MS=4000
GOV_API_RETRY_COUNT=1
